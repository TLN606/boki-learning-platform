<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Boki Admin</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              boki: { blue: '#4A90E2', purple: '#9B51E0', orange: '#F2994A', yellow: '#F2C94C', green: '#27AE60', pink: '#FF7675', gray: '#F0F3F7', dark: '#2D3436' }
            },
            fontFamily: { nunito: ['Nunito', 'sans-serif'], inter: ['Inter', 'sans-serif'] }
          }
        }
      }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAFC; color: #1E293B; overflow-x: hidden; }
        .font-nunito { font-family: 'Nunito', sans-serif; }
        
        .admin-card {
            background-color: #ffffff;
            border-radius: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            border: 1px solid #E2E8F0;
        }
        
        .admin-sidebar-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.875rem 1.25rem;
            border-radius: 1rem;
            font-weight: 600;
            color: #64748B;
            transition: all 0.2s;
        }
        .admin-sidebar-item:hover {
            background-color: #F1F5F9;
            color: #334155;
        }
        .admin-sidebar-item.active {
            background-color: #EFF6FF;
            color: #4A90E2;
            font-weight: 700;
        }
        
        /* Custom Table */
        .admin-table th { background-color: #F8FAFC; color: #64748B; font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding: 1rem; border-bottom: 1px solid #E2E8F0; text-align: left; }
        .admin-table td { padding: 1rem; border-bottom: 1px solid #E2E8F0; color: #334155; font-weight: 500; }
        .admin-table tbody tr:hover { background-color: #F8FAFC; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="min-h-screen flex antialiased">
    <!-- ADMIN SIDEBAR -->
    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col fixed h-full z-20">
        <div class="px-6 py-8 flex items-center gap-3">
            <div class="w-10 h-10 bg-boki-dark text-white rounded-xl flex items-center justify-center font-black text-xl font-nunito">B</div>
            <div>
                <span class="text-2xl font-black tracking-tight block leading-none font-nunito">Boki</span>
                <span class="text-[0.65rem] font-bold text-slate-400 uppercase tracking-widest mt-1 block">Admin Portal</span>
            </div>
        </div>
        
        <div class="px-4 flex-grow flex flex-col gap-2 mt-2">
            <a href="/Admin/Dashboard" class="admin-sidebar-item active">
                <i class="fas fa-chart-pie w-5 text-center"></i> Tổng quan
            </a>
            <a href="/Admin/Students" class="admin-sidebar-item">
                <i class="fas fa-users w-5 text-center"></i> Quản lý Học sinh
            </a>
            <a href="/Admin/Lessons" class="admin-sidebar-item">
                <i class="fas fa-book-open w-5 text-center"></i> Quản lý Bài học
            </a>
            <a href="/Admin/Questions" class="admin-sidebar-item">
                <i class="fas fa-question-circle w-5 text-center"></i> Quản lý Câu hỏi
            </a>
            <a href="/Admin/Results" class="admin-sidebar-item">
                <i class="fas fa-star w-5 text-center"></i> Kết quả học tập
            </a>
        </div>
        
        <div class="p-4 border-t border-slate-200">
            <div class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition cursor-pointer">
                <img src="https://api.dicebear.com/7.x/initials/svg?seed=Admin&backgroundColor=4A90E2" class="w-10 h-10 rounded-full bg-slate-200 object-cover" alt="Admin">
                <div class="flex-grow overflow-hidden">
                    <div class="font-bold text-sm text-slate-700 truncate">Quản trị viên</div>
                    <div class="text-xs text-slate-500 font-medium truncate">admin@boki.vn</div>
                </div>
                <button class="text-slate-400 hover:text-red-500 transition"><i class="fas fa-sign-out-alt"></i></button>
            </div>
        </div>
    </aside>

    <!-- ADMIN CONTENT -->
    <main class="flex-grow ml-64 min-h-screen">
        <!-- Topbar -->
        <header class="bg-white/80 backdrop-blur-md border-b border-slate-200 px-8 py-4 sticky top-0 z-10 flex justify-between items-center">
            <h1 class="text-2xl font-black tracking-tight font-nunito text-slate-800">@ViewBag.Title</h1>
            <div class="flex gap-4 items-center">
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" placeholder="Tìm kiếm nhanh..." class="bg-slate-100 border-none rounded-full py-2 pl-10 pr-4 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-boki-blue w-64 transition">
                </div>
                <button class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 hover:text-boki-blue relative transition">
                    <i class="fas fa-bell"></i>
                    <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border border-white"></span>
                </button>
            </div>
        </header>

        <!-- Page Body -->
        <div class="p-8">
            @RenderBody()
        </div>
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>
