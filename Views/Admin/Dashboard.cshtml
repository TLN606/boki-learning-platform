@{
    ViewBag.Title = "Tổng Quan Boki";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Stats Row -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
    <div class="admin-card p-6 flex items-center justify-between">
        <div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">Học sinh</p>
            <h3 class="text-3xl font-black text-slate-800">1,245</h3>
            <p class="text-xs font-bold text-emerald-500 mt-2 flex items-center gap-1"><i class="fas fa-arrow-up"></i> 12% tháng trước</p>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-500 flex items-center justify-center text-2xl"><i class="fas fa-users"></i></div>
    </div>
    
    <div class="admin-card p-6 flex items-center justify-between">
        <div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">Bài Học</p>
            <h3 class="text-3xl font-black text-slate-800">48</h3>
            <p class="text-xs font-bold text-emerald-500 mt-2 flex items-center gap-1"><i class="fas fa-arrow-up"></i> 4 bài mới</p>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-orange-50 text-orange-500 flex items-center justify-center text-2xl"><i class="fas fa-book-open"></i></div>
    </div>
    
    <div class="admin-card p-6 flex items-center justify-between">
        <div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">Câu Hỏi</p>
            <h3 class="text-3xl font-black text-slate-800">620</h3>
            <p class="text-xs font-bold text-emerald-500 mt-2 flex items-center gap-1"><i class="fas fa-arrow-up"></i> Ngân hàng dồi dào</p>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-purple-50 text-purple-500 flex items-center justify-center text-2xl"><i class="fas fa-question-circle"></i></div>
    </div>
    
    <div class="admin-card p-6 flex items-center justify-between">
        <div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">Lượt Thi</p>
            <h3 class="text-3xl font-black text-slate-800">8,590</h3>
            <p class="text-xs font-bold text-emerald-500 mt-2 flex items-center gap-1"><i class="fas fa-arrow-up"></i> 24% hôm nay</p>
        </div>
        <div class="w-14 h-14 rounded-2xl bg-green-50 text-green-500 flex items-center justify-center text-2xl"><i class="fas fa-star"></i></div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Quick Actions & Results -->
    <div class="lg:col-span-1 flex flex-col gap-6">
        <div class="admin-card p-6">
            <h3 class="text-lg font-black text-slate-800 mb-4">Thao tác nhanh ⚡</h3>
            <div class="flex flex-col gap-3">
                <a href="/Admin/Lessons/Create" class="w-full py-3 px-4 rounded-xl bg-boki-blue/10 text-boki-blue font-bold flex items-center justify-between hover:bg-boki-blue hover:text-white transition group">
                    <span class="flex items-center gap-3"><div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center"><i class="fas fa-plus"></i></div> Thêm Bài Học</span>
                    <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 transform -translate-x-2 group-hover:translate-x-0 transition"></i>
                </a>
                <a href="/Admin/Questions/Create" class="w-full py-3 px-4 rounded-xl bg-boki-orange/10 text-boki-orange font-bold flex items-center justify-between hover:bg-boki-orange hover:text-white transition group">
                    <span class="flex items-center gap-3"><div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center"><i class="fas fa-question"></i></div> Thêm Câu Hỏi</span>
                    <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 transform -translate-x-2 group-hover:translate-x-0 transition"></i>
                </a>
                <a href="/Admin/Students/Create" class="w-full py-3 px-4 rounded-xl bg-boki-green/10 text-boki-green font-bold flex items-center justify-between hover:bg-boki-green hover:text-white transition group">
                    <span class="flex items-center gap-3"><div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center"><i class="fas fa-user-plus"></i></div> Đăng Ký Học Sinh</span>
                    <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 transform -translate-x-2 group-hover:translate-x-0 transition"></i>
                </a>
            </div>
        </div>

        <div class="admin-card p-6 flex-grow">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-black text-slate-800">Kết quả mới nhất 📈</h3>
                <a href="/Admin/Results" class="text-sm font-bold text-boki-blue hover:underline">Xem hết</a>
            </div>
            <div class="flex flex-col gap-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-slate-500">M</div>
                        <div>
                            <div class="font-bold text-slate-800 text-sm">Minh Ngọc</div>
                            <div class="text-xs text-slate-400 font-medium">Bảng Nhân 6</div>
                        </div>
                    </div>
                    <div class="font-black text-green-500 bg-green-50 px-2 py-1 rounded text-sm">100đ</div>
                </div>
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-slate-500">D</div>
                        <div>
                            <div class="font-bold text-slate-800 text-sm">Trí Dũng</div>
                            <div class="text-xs text-slate-400 font-medium">Tập làm văn Lớp 5</div>
                        </div>
                    </div>
                    <div class="font-black text-orange-500 bg-orange-50 px-2 py-1 rounded text-sm">80đ</div>
                </div>
                <div class="flex items-center justify-between pb-1">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-bold text-slate-500">H</div>
                        <div>
                            <div class="font-bold text-slate-800 text-sm">Lan Hương</div>
                            <div class="text-xs text-slate-400 font-medium">Hello! What's your name?</div>
                        </div>
                    </div>
                    <div class="font-black text-red-500 bg-red-50 px-2 py-1 rounded text-sm">40đ</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="lg:col-span-2 flex flex-col items-stretch">
        <div class="admin-card overflow-hidden h-full flex flex-col">
            <div class="p-6 border-b border-slate-200 flex justify-between items-center bg-white">
                <h3 class="text-lg font-black text-slate-800">Cập nhật học sinh gần đây 🧑‍🎓</h3>
                <a href="/Admin/Students" class="text-sm border border-slate-200 rounded-lg px-3 py-1.5 font-bold hover:bg-slate-50 transition">Quản lý <i class="fas fa-arrow-right ml-1 text-xs text-slate-400"></i></a>
            </div>
            <div class="overflow-x-auto flex-grow">
                <table class="w-full admin-table">
                    <thead>
                        <tr>
                            <th>Học Sinh</th>
                            <th>Lớp</th>
                            <th>Tài Khoản</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-boki-purple/10 text-boki-purple flex items-center justify-center font-bold text-xs">M</div>
                                    <span class="font-bold">Minh Ngọc</span>
                                </div>
                            </td>
                            <td><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-bold">Lớp 3</span></td>
                            <td class="text-sm font-medium">hs1@boki.edu.vn</td>
                            <td><span class="bg-green-100 text-green-700 font-bold px-2 py-1 rounded text-[0.65rem] uppercase tracking-wide"><i class="fas fa-circle text-[8px] mr-1"></i> Active</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-boki-blue/10 text-boki-blue flex items-center justify-center font-bold text-xs">D</div>
                                    <span class="font-bold">Duy Anh</span>
                                </div>
                            </td>
                            <td><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-bold">Lớp 2</span></td>
                            <td class="text-sm font-medium">hs2@boki.edu.vn</td>
                            <td><span class="bg-green-100 text-green-700 font-bold px-2 py-1 rounded text-[0.65rem] uppercase tracking-wide"><i class="fas fa-circle text-[8px] mr-1"></i> Active</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center font-bold text-xs">T</div>
                                    <span class="font-bold">Trí Dũng</span>
                                </div>
                            </td>
                            <td><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-bold">Lớp 5</span></td>
                            <td class="text-sm font-medium">hs3@boki.edu.vn</td>
                            <td><span class="bg-slate-100 text-slate-500 font-bold px-2 py-1 rounded text-[0.65rem] uppercase tracking-wide"><i class="fas fa-minus-circle text-[8px] mr-1"></i> Offline</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-boki-orange/10 text-boki-orange flex items-center justify-center font-bold text-xs">H</div>
                                    <span class="font-bold">Hải Đăng</span>
                                </div>
                            </td>
                            <td><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-bold">Lớp 4</span></td>
                            <td class="text-sm font-medium">hs4@boki.edu.vn</td>
                            <td><span class="bg-green-100 text-green-700 font-bold px-2 py-1 rounded text-[0.65rem] uppercase tracking-wide"><i class="fas fa-circle text-[8px] mr-1"></i> Active</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-boki-pink/10 text-boki-pink flex items-center justify-center font-bold text-xs">L</div>
                                    <span class="font-bold">Lan Hương</span>
                                </div>
                            </td>
                            <td><span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-bold">Lớp 3</span></td>
                            <td class="text-sm font-medium">hs5@boki.edu.vn</td>
                            <td><span class="bg-green-100 text-green-700 font-bold px-2 py-1 rounded text-[0.65rem] uppercase tracking-wide"><i class="fas fa-circle text-[8px] mr-1"></i> Active</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
