@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-col gap-16">
    <!-- Hero Section -->
    <section class="flex flex-col md:flex-row items-center gap-10 mt-6 px-4">
        <div class="flex-1 flex flex-col items-center md:items-start text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-boki-yellow/20 text-boki-orange font-bold rounded-full mb-6 shadow-sm border border-boki-yellow/30">
                <span class="text-xl">✨</span> Nền tảng học Toán, Văn, Anh cực vui!
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-boki-dark leading-tight mb-6 tracking-tight">
                Cùng <span class="text-boki-blue underline decoration-boki-yellow decoration-4 underline-offset-8">Boki</span> Khám Phá <br/>
                <span class="text-boki-purple">Tri Thức</span> Bao La 🚀
            </h1>
            <p class="text-lg font-bold text-boki-dark/60 mb-8 max-w-xl">Học tập chưa bao giờ vui đến thế! Tham gia ngay cùng giáo viên thiết kế lộ trình rèn luyện chuyên biệt cho học sinh Lớp 2-5.</p>
            <div class="flex flex-wrap gap-4 justify-center md:justify-start">
                <a href="/Auth/Register" class="clay-btn clay-primary px-8 py-4 text-lg">Bắt đầu học ngay 🚀</a>
                <a href="#features" class="clay-btn px-8 py-4 text-lg text-boki-dark">Tìm hiểu thêm 🤔</a>
            </div>
        </div>
        <div class="flex-1 relative w-full flex justify-center">
            <div class="w-full max-w-sm aspect-square clay-card bg-white relative flex items-center justify-center">
                 <div class="absolute -top-6 -left-6 w-24 h-24 bg-boki-yellow rounded-full animate-bounce shadow-xl border-4 border-white" style="animation-duration: 3s"></div>
                 <div class="absolute -bottom-4 -right-4 w-20 h-20 bg-boki-green rounded-full animate-bounce shadow-xl border-4 border-white" style="animation-duration: 4s; animation-delay: 1s"></div>
                 <img src="https://api.dicebear.com/7.x/bottts/svg?seed=BokiHero&backgroundColor=e0f2fe" alt="Boki Mascot" class="w-3/4 h-3/4 object-contain drop-shadow-2xl">
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-12 px-4 relative">
        <div class="text-center mb-12">
            <h2 class="text-3xl lg:text-4xl font-black text-boki-dark mb-4">🌟 Tại sao chọn Boki?</h2>
            <p class="font-bold text-lg text-boki-dark/60">3 tính năng nổi bật giúp trẻ thích thú học tập</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="clay-card p-8 flex flex-col items-center text-center group hover:-translate-y-2 transition-transform duration-300">
                <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-4xl text-boki-orange mb-6 bg-white shadow-clay group-hover:rotate-12 transition-transform">📖</div>
                <h3 class="text-2xl font-black mb-3 text-boki-dark">Lý thuyết rõ ràng</h3>
                <p class="font-semibold text-boki-dark/60">Bài giảng bám sát SGK, minh họa sinh động, siêu dễ hiểu.</p>
            </div>
            <div class="clay-card p-8 flex flex-col items-center text-center group hover:-translate-y-2 transition-transform duration-300">
                <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-4xl text-boki-blue mb-6 bg-white shadow-clay group-hover:-rotate-12 transition-transform">⚙️</div>
                <h3 class="text-2xl font-black mb-3 text-boki-dark">Trắc nghiệm nhanh</h3>
                <p class="font-semibold text-boki-dark/60">Ngân hàng câu hỏi game hóa, vừa học vừa chơi, hiển thị kết quả ngay.</p>
            </div>
            <div class="clay-card p-8 flex flex-col items-center text-center group hover:-translate-y-2 transition-transform duration-300">
                <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-4xl text-boki-green mb-6 bg-white shadow-clay group-hover:rotate-12 transition-transform">📈</div>
                <h3 class="text-2xl font-black mb-3 text-boki-dark">Giải thích chi tiết</h3>
                <p class="font-semibold text-boki-dark/60">Biết ngay tại sao sai, xem lại lý thuyết kèm theo mẹo ghi nhớ.</p>
            </div>
        </div>
    </section>

    <!-- Course Catalog Preview -->
    <section class="py-12 px-4">
        <div class="clay-card bg-white p-8 md:p-12 rounded-[3rem]">
            <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4">
                <div class="text-center md:text-left">
                    <h2 class="text-3xl font-black text-boki-dark mb-2">📚 Khám phá khóa học</h2>
                    <p class="font-bold text-lg text-boki-dark/60">Chinh phục 3 môn học cốt lõi</p>
                </div>
                <a href="/Lesson/Index" class="clay-btn px-6 py-3 text-boki-blue whitespace-nowrap">Xem tất cả <i class="fas fa-arrow-right ml-2 opacity-70"></i></a>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card Toán -->
                <div class="clay-card overflow-hidden flex flex-col group border-[3px] border-boki-blue/20">
                    <div class="h-32 bg-boki-blue/10 flex items-center justify-center text-6xl group-hover:scale-110 transition duration-500 overflow-hidden relative">
                        <span class="relative z-10 drop-shadow-md">🔢</span>
                        <div class="absolute inset-0 bg-gradient-to-t from-boki-blue/20 to-transparent"></div>
                    </div>
                    <div class="p-6 flex-grow flex flex-col">
                        <span class="px-3 py-1 bg-white rounded-full text-xs font-black text-boki-blue shadow-clay-sm w-fit mb-3">Lớp 2-5</span>
                        <h3 class="text-2xl font-black mb-2 text-boki-dark">Toán Học</h3>
                        <p class="text-sm font-bold text-boki-dark/50 mb-6 flex-grow">Các phép tính, hình học trực quan, luyện tư duy logic mỗi ngày.</p>
                        <a href="/Lesson/Index" class="block w-full text-center clay-btn text-boki-blue py-3">Học thử ngay 👋</a>
                    </div>
                </div>
                
                <!-- Card Văn -->
                <div class="clay-card overflow-hidden flex flex-col group border-[3px] border-boki-orange/20">
                    <div class="h-32 bg-boki-orange/10 flex items-center justify-center text-6xl group-hover:scale-110 transition duration-500 overflow-hidden relative">
                        <span class="relative z-10 drop-shadow-md">📖</span>
                        <div class="absolute inset-0 bg-gradient-to-t from-boki-orange/20 to-transparent"></div>
                    </div>
                    <div class="p-6 flex-grow flex flex-col">
                        <span class="px-3 py-1 bg-white rounded-full text-xs font-black text-boki-orange shadow-clay-sm w-fit mb-3">Lớp 2-5</span>
                        <h3 class="text-2xl font-black mb-2 text-boki-dark">Tiếng Việt</h3>
                        <p class="text-sm font-bold text-boki-dark/50 mb-6 flex-grow">Luyện đọc diễn cảm, chính tả, tập làm văn thỏa sức sáng tạo.</p>
                        <a href="/Lesson/Index" class="block w-full text-center clay-btn text-boki-orange py-3">Học thử ngay 👋</a>
                    </div>
                </div>
                
                <!-- Card Anh -->
                <div class="clay-card overflow-hidden flex flex-col group border-[3px] border-boki-green/20">
                    <div class="h-32 bg-boki-green/10 flex items-center justify-center text-6xl group-hover:scale-110 transition duration-500 overflow-hidden relative">
                        <span class="relative z-10 drop-shadow-md">🌍</span>
                        <div class="absolute inset-0 bg-gradient-to-t from-boki-green/20 to-transparent"></div>
                    </div>
                    <div class="p-6 flex-grow flex flex-col">
                        <span class="px-3 py-1 bg-white rounded-full text-xs font-black text-boki-green shadow-clay-sm w-fit mb-3">Lớp 2-5</span>
                        <h3 class="text-2xl font-black mb-2 text-boki-dark">Tiếng Anh</h3>
                        <p class="text-sm font-bold text-boki-dark/50 mb-6 flex-grow">Từ vựng theo chủ đề, ngữ pháp cơ bản, rèn luyện nghe nói.</p>
                        <a href="/Lesson/Index" class="block w-full text-center clay-btn text-boki-green py-3">Học thử ngay 👋</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Progress tracking demo -->
    <section class="py-12 px-4">
        <div class="clay-card p-8 md:p-12 shadow-clay items-center gap-12 flex flex-col md:flex-row-reverse bg-gradient-to-br from-boki-gray to-white">
            <div class="flex-1 w-full max-w-sm mx-auto">
                <div class="clay-card bg-white p-6 relative z-10 border border-white">
                    <div class="flex items-center gap-3 mb-6">
                        <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Kids" class="w-12 h-12 rounded-full bg-boki-yellow p-1 shadow-sm">
                        <h4 class="font-black text-xl text-boki-dark">Tiến độ của bé</h4>
                    </div>
                    
                    <div class="mb-4">
                        <div class="flex justify-between items-center mb-2">
                            <span class="font-bold text-boki-dark/80">Toán lớp 3</span>
                            <span class="font-black text-boki-blue">70%</span>
                        </div>
                        <div class="w-full h-4 bg-boki-gray rounded-full shadow-inner mb-1">
                            <div class="h-full bg-boki-blue text-xs rounded-full w-[70%] shadow-lg transition-all duration-1000"></div>
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <div class="flex justify-between items-center mb-2">
                            <span class="font-bold text-boki-dark/80">Tiếng Việt lớp 3</span>
                            <span class="font-black text-boki-green">90%</span>
                        </div>
                        <div class="w-full h-4 bg-boki-gray rounded-full shadow-inner mb-1">
                            <div class="h-full bg-boki-green text-xs rounded-full w-[90%] shadow-lg transition-all duration-1000"></div>
                        </div>
                    </div>
                    
                    <div class="flex justify-between items-center pt-4 border-t border-slate-100">
                        <div class="flex items-center gap-2 font-black text-boki-orange bg-boki-orange/10 px-3 py-1 rounded-lg">
                            <i class="fas fa-fire"></i> 5 ngày Streak
                        </div>
                        <div class="font-black text-boki-purple flex items-center gap-1">
                            <span>1200</span> <i class="fas fa-star text-boki-yellow drop-shadow-sm"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex-1 text-center md:text-left">
                <h2 class="text-3xl lg:text-4xl font-black text-boki-dark mb-4">Ghi Nhận <span class="text-boki-green">Từng Bước</span> Phát Triển</h2>
                <p class="text-lg font-bold text-boki-dark/60 mb-8">Hệ thống thông minh lưu lại mọi kết quả! Giúp bé tự hào với quá trình học qua từng huy hiệu (badge) và ngày duy trì (streak).</p>
                <div class="flex gap-4 items-center justify-center md:justify-start">
                    <div class="w-14 h-14 bg-white rounded-2xl shadow-clay flex items-center justify-center text-2xl text-yellow-500 transform -rotate-6">🏆</div>
                    <div class="w-14 h-14 bg-white rounded-2xl shadow-clay flex items-center justify-center text-2xl text-red-500 transform rotate-3">🏅</div>
                    <div class="w-14 h-14 bg-white rounded-2xl shadow-clay flex items-center justify-center text-2xl text-blue-500 transform -rotate-3">💎</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="py-12 px-4 mb-4">
        <h2 class="text-3xl lg:text-4xl font-black text-center text-boki-dark mb-12">Khách Hàng Nói Gì? 💬</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-6">
            <div class="clay-card bg-white p-6 relative">
                <div class="absolute -top-8 left-6 w-16 h-16 bg-boki-blue text-white rounded-full flex items-center justify-center text-2xl font-black shadow-clay border-4 border-white">
                    <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Kid1" class="w-full h-full rounded-full">
                </div>
                <div class="text-xl font-black text-boki-dark mb-1 mt-6">Minh Ngọc</div>
                <div class="text-sm font-bold text-boki-blue mb-3">Học sinh Lớp 3</div>
                <div class="flex gap-1 text-boki-yellow mb-4 text-sm drop-shadow-sm">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <p class="font-bold text-boki-dark/70 text-lg leading-snug">"Boki vui lắm luôn! Con thích nhất lúc làm quiz được thưởng sao lấp lánh."</p>
            </div>
            
            <div class="clay-card bg-white p-6 relative transform md:-translate-y-6">
                <div class="absolute -top-8 left-6 w-16 h-16 bg-boki-pink text-white rounded-full flex items-center justify-center text-2xl font-black shadow-clay border-4 border-white">
                    <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Mom" class="w-full h-full rounded-full">
                </div>
                <div class="text-xl font-black text-boki-dark mb-1 mt-6">Mẹ bé Duy</div>
                <div class="text-sm font-bold text-boki-pink mb-3">Phụ huynh Lớp 2</div>
                <div class="flex gap-1 text-boki-yellow mb-4 text-sm drop-shadow-sm">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <p class="font-bold text-boki-dark/70 text-lg leading-snug">"Giao diện thân thiện, con tự mở máy tính học mà không cần nhắc. Thật sự hiệu quả."</p>
            </div>
            
            <div class="clay-card bg-white p-6 relative">
                <div class="absolute -top-8 left-6 w-16 h-16 bg-boki-orange text-white rounded-full flex items-center justify-center text-2xl font-black shadow-clay border-4 border-white">
                    <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Boy" class="w-full h-full rounded-full">
                </div>
                <div class="text-xl font-black text-boki-dark mb-1 mt-6">Trí Dũng</div>
                <div class="text-sm font-bold text-boki-orange mb-3">Học sinh Lớp 5</div>
                <div class="flex gap-1 text-boki-yellow mb-4 text-sm drop-shadow-sm">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i>
                </div>
                <p class="font-bold text-boki-dark/70 text-lg leading-snug">"Các mẹo nhớ Toán dễ hiểu lắm. Câu sai cũng được coi lại đáp án đúng luôn."</p>
            </div>
        </div>
    </section>

    <!-- Enrollment CTA -->
    <section class="px-4 pb-12">
        <div class="clay-card p-10 md:p-14 bg-boki-blue text-white text-center rounded-[3rem] shadow-clay overflow-hidden relative border-none">
            <div class="absolute top-0 left-0 w-64 h-64 bg-white/20 rounded-full blur-3xl -translate-x-1/4 -translate-y-1/4"></div>
            <div class="absolute bottom-0 right-0 w-80 h-80 bg-boki-purple/40 rounded-full blur-3xl translate-x-1/4 translate-y-1/4"></div>
            
            <h2 class="text-4xl md:text-5xl font-black mb-6 relative z-10 drop-shadow-md">Sẵn Sàng Tham Gia Cùng Boki?</h2>
            <p class="text-xl font-bold mb-10 opacity-90 max-w-2xl mx-auto relative z-10">Môi trường vui nhộn, không sợ sai, thoải mái trải nghiệm. Miễn phí tài khoản dùng thử!</p>
            <div class="relative z-10 flex gap-4 justify-center">
                <a href="/Auth/Register" class="clay-btn bg-white text-boki-blue px-10 py-5 text-xl">Tham Gia Ngay Trẻ Ơi! 🎉</a>
            </div>
        </div>
    </section>
</div>
