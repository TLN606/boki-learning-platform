@{
    ViewBag.Title = "Đăng Nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Boki</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: { boki: { blue: '#4A90E2', purple: '#9B51E0', orange: '#F2994A', yellow: '#F2C94C', green: '#27AE60', pink: '#FF7675', gray: '#F0F3F7', dark: '#2D3436' } },
            fontFamily: { nunito: ['Nunito', 'sans-serif'], inter: ['Inter', 'sans-serif'] }
          }
        }
      }
    </script>
    <style>
        body { font-family: 'Nunito', sans-serif; background-color: #F0F3F7; overflow-x: hidden; }
        .clay-card {
            background-color: #F0F3F7; border-radius: 2.5rem;
            box-shadow: inset -8px -8px 16px rgba(0,0,0,0.05), inset 8px 8px 16px rgba(255,255,255,0.8), 20px 20px 40px rgba(0,0,0,0.08);
            border: 2px solid rgba(255,255,255,0.6);
        }
        .clay-input {
            background-color: #F0F3F7; border-radius: 1rem;
            box-shadow: inset 4px 4px 8px rgba(0,0,0,0.05), inset -4px -4px 8px rgba(255,255,255,0.8);
            border: 2px solid transparent; width: 100%; padding: 1rem 1.25rem; outline: none; transition: all 0.2s; font-weight: 700; color: #2D3436;
        }
        .clay-input:focus { border-color: rgba(74,144,226,0.3); box-shadow: inset 6px 6px 10px rgba(0,0,0,0.08), inset -6px -6px 10px rgba(255,255,255,0.9); }
        .clay-btn-primary {
            background-color: #4A90E2; color: white; border-radius: 9999px; font-weight: 800; cursor: pointer;
            box-shadow: inset -4px -4px 8px rgba(0,0,0,0.15), inset 4px 4px 8px rgba(255,255,255,0.2), 5px 5px 15px rgba(74,144,226,0.3);
            transition: all 0.2s; display: block; text-align: center;
        }
        .clay-btn-primary:active { transform: translateY(2px); box-shadow: inset 4px 4px 8px rgba(0,0,0,0.3), inset -4px -4px 8px rgba(255,255,255,0.1); }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center relative bg-gradient-to-br from-boki-blue/10 via-boki-gray to-boki-purple/10">
    <!-- Decorative Blobs -->
    <div class="absolute top-10 left-10 w-64 h-64 bg-boki-yellow/30 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-boki-blue/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s"></div>

    <div class="z-10 w-full max-w-md px-4">
        <div class="clay-card p-10 flex flex-col items-center">
            <div class="w-16 h-16 bg-boki-orange text-white rounded-full flex items-center justify-center font-black text-3xl shadow-lg mb-4 border-4 border-white">B</div>
            <h1 class="text-3xl font-black text-boki-dark mb-1">Boki! Xin chào 👋</h1>
            <p class="text-boki-dark/50 font-bold mb-8 text-center text-sm">Đăng nhập để tiếp tục hành trình khám phá</p>

            <form action="/Auth/Login" method="POST" class="w-full flex flex-col gap-5">
                <div>
                    <label class="block text-xs font-black text-boki-dark/70 mb-2 pl-2 tracking-widest">TÀI KHOẢN</label>
                    <input type="text" name="username" class="clay-input" placeholder="Tên đăng nhập / Email">
                </div>
                <div>
                    <label class="block text-xs font-black text-boki-dark/70 mb-2 pl-2 tracking-widest">MẬT KHẨU</label>
                    <input type="password" name="password" class="clay-input" placeholder="Nhập mật khẩu bí mật 🤫">
                </div>
                
                <div class="flex justify-end px-2">
                    <a href="#" class="text-sm font-bold text-boki-blue hover:text-boki-purple transition">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="clay-btn-primary w-full py-4 text-xl mt-4">Vào Lớp Ngay 🚀</button>
            </form>

            <div class="mt-8 pt-6 border-t border-boki-dark/5 w-full text-center">
                <p class="font-bold text-boki-dark/60 text-sm">Chưa có tài khoản? <a href="/Auth/Register" class="text-boki-blue hover:underline">Đăng ký tại trường</a></p>
            </div>
        </div>
    </div>
</body>
</html>
