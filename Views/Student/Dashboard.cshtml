@{
    ViewBag.Title = "Bảng Điều Khiển";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-col gap-10">
    <!-- Welcome Banner -->
    <section class="clay-card bg-white p-8 md:p-10 rounded-[2.5rem] relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6 border-none">
        <div class="absolute inset-0 bg-gradient-to-r from-boki-blue/10 to-transparent"></div>
        <div class="flex items-center gap-6 relative z-10 w-full md:w-auto">
            <div class="w-20 h-20 bg-boki-yellow rounded-full flex items-center justify-center shadow-lg border-4 border-white shrink-0">
                <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Hs1" class="w-16 h-16 rounded-full" alt="Avatar">
            </div>
            <div>
                <h1 class="text-2xl md:text-3xl font-black text-boki-dark mb-1">Chào buổi sáng, <span class="text-boki-blue">Minh Ngọc</span>! ☀️</h1>
                <p class="font-bold text-boki-dark/60">Hôm nay bạn muốn khám phá điều gì mới?</p>
            </div>
        </div>
        <div class="flex gap-4 relative z-10 self-start md:self-center">
            <div class="flex flex-col items-center justify-center bg-white rounded-2xl p-3 shadow-clay-sm min-w[80px]">
                <span class="text-boki-orange text-xl"><i class="fas fa-fire"></i></span>
                <span class="font-black text-boki-dark">5 Ngày</span>
                <span class="text-[0.65rem] uppercase font-bold text-boki-dark/50 tracking-wider">Streak</span>
            </div>
            <div class="flex flex-col items-center justify-center bg-white rounded-2xl p-3 shadow-clay-sm min-w[80px]">
                <span class="text-boki-yellow text-xl"><i class="fas fa-star"></i></span>
                <span class="font-black text-boki-dark">1,200</span>
                <span class="text-[0.65rem] uppercase font-bold text-boki-dark/50 tracking-wider">Điểm số</span>
            </div>
        </div>
    </section>

    <!-- Grade & Subject Selector -->
    <section>
        <div class="flex justify-between items-end mb-6">
            <h2 class="text-2xl font-black text-boki-dark">📚 Lớp Học Hiện Tại</h2>
            <div class="relative">
                <button class="clay-btn px-6 py-3 text-sm bg-white flex items-center gap-2 text-boki-dark font-bold shadow-sm">
                    Khối Lớp 3 <i class="fas fa-chevron-down opacity-50 ml-1"></i>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <!-- Subject Toán -->
            <a href="/Lesson/Index?subject=Toan" class="clay-card p-6 flex flex-col items-center text-center group cursor-pointer hover:-translate-y-2 transition-transform duration-300 border-[3px] border-boki-blue/20">
                <div class="w-20 h-20 rounded-full bg-boki-blue/10 flex items-center justify-center text-4xl mb-4 group-hover:scale-110 transition shadow-inner">🔢</div>
                <h3 class="text-xl font-black text-boki-dark mb-2 group-hover:text-boki-blue transition">Toán Học</h3>
                <div class="w-full bg-boki-gray h-3 rounded-full overflow-hidden mb-3 shadow-inner border border-boki-dark/5">
                    <div class="bg-boki-blue h-full w-[70%] rounded-full shadow-md"></div>
                </div>
                <div class="flex justify-between w-full text-xs font-bold text-boki-dark/50">
                    <span>Đã học 14/20 bài</span>
                    <span class="text-boki-blue font-black bg-boki-blue/10 px-2 rounded-md">70%</span>
                </div>
            </a>
            
            <!-- Subject Văn -->
            <a href="/Lesson/Index?subject=Van" class="clay-card p-6 flex flex-col items-center text-center group cursor-pointer hover:-translate-y-2 transition-transform duration-300 border-[3px] border-boki-orange/20">
                <div class="w-20 h-20 rounded-full bg-boki-orange/10 flex items-center justify-center text-4xl mb-4 group-hover:scale-110 transition shadow-inner">📖</div>
                <h3 class="text-xl font-black text-boki-dark mb-2 group-hover:text-boki-orange transition">Tiếng Việt</h3>
                <div class="w-full bg-boki-gray h-3 rounded-full overflow-hidden mb-3 shadow-inner border border-boki-dark/5">
                    <div class="bg-boki-orange h-full w-[90%] rounded-full shadow-md"></div>
                </div>
                <div class="flex justify-between w-full text-xs font-bold text-boki-dark/50">
                    <span>Đã học 18/20 bài</span>
                    <span class="text-boki-orange font-black bg-boki-orange/10 px-2 rounded-md">90%</span>
                </div>
            </a>
            
            <!-- Subject Anh -->
            <a href="/Lesson/Index?subject=Anh" class="clay-card p-6 flex flex-col items-center text-center group cursor-pointer hover:-translate-y-2 transition-transform duration-300 border-[3px] border-boki-green/20">
                <div class="w-20 h-20 rounded-full bg-boki-green/10 flex items-center justify-center text-4xl mb-4 group-hover:scale-110 transition shadow-inner">🌍</div>
                <h3 class="text-xl font-black text-boki-dark mb-2 group-hover:text-boki-green transition">Tiếng Anh</h3>
                <div class="w-full bg-boki-gray h-3 rounded-full overflow-hidden mb-3 shadow-inner border border-boki-dark/5">
                    <div class="bg-boki-green h-full w-[30%] rounded-full shadow-md"></div>
                </div>
                <div class="flex justify-between w-full text-xs font-bold text-boki-dark/50">
                    <span>Đã học 6/20 bài</span>
                    <span class="text-boki-green font-black bg-boki-green/10 px-2 rounded-md">30%</span>
                </div>
            </a>
        </div>
    </section>

    <!-- Recent Activity -->
    <section>
        <h2 class="text-2xl font-black text-boki-dark mb-6">🕒 Hoạt Động Gần Đây</h2>
        <div class="flex flex-col gap-4">
            <div class="clay-card p-4 md:p-6 flex flex-col md:flex-row justify-between items-center gap-4 bg-white hover:bg-slate-50 transition border border-white group">
                <div class="flex items-center gap-4 w-full md:w-auto">
                    <div class="w-14 h-14 bg-boki-orange/10 rounded-2xl flex items-center justify-center text-2xl shadow-inner group-hover:scale-110 transition">📖</div>
                    <div>
                        <h4 class="font-black text-boki-dark text-lg group-hover:text-boki-orange transition">Bài 3: Từ chỉ sự vật</h4>
                        <p class="text-sm font-bold text-boki-dark/50">Tiếng Việt Lớp 3 &bull; Hôm qua</p>
                    </div>
                </div>
                <div class="flex items-center gap-6 w-full md:w-auto justify-between md:justify-end">
                    <div class="text-right">
                        <div class="font-black text-boki-green text-lg">100 / 100 điểm</div>
                        <div class="text-xs font-bold text-boki-dark/40 bg-boki-green/10 px-2 py-1 rounded inline-block mt-1">Hoàn hảo! 🎉</div>
                    </div>
                    <a href="/Lesson/Detail/3" class="clay-btn px-6 py-3 bg-white text-sm font-bold whitespace-nowrap text-boki-blue">Học lại</a>
                </div>
            </div>

            <div class="clay-card p-4 md:p-6 flex flex-col md:flex-row justify-between items-center gap-4 bg-white hover:bg-slate-50 transition border border-white group">
                <div class="flex items-center gap-4 w-full md:w-auto">
                    <div class="w-14 h-14 bg-boki-blue/10 rounded-2xl flex items-center justify-center text-2xl shadow-inner group-hover:scale-110 transition">🔢</div>
                    <div>
                        <h4 class="font-black text-boki-dark text-lg group-hover:text-boki-blue transition">Bài 4: Bảng nhân 6</h4>
                        <p class="text-sm font-bold text-boki-dark/50">Toán Học Lớp 3 &bull; 2 ngày trước</p>
                    </div>
                </div>
                <div class="flex items-center gap-6 w-full md:w-auto justify-between md:justify-end">
                    <div class="text-right">
                        <div class="font-black text-boki-orange text-lg">80 / 100 điểm</div>
                        <div class="text-xs font-bold text-boki-dark/40 bg-boki-orange/10 px-2 py-1 rounded inline-block mt-1">Cố lên nhé! 💪</div>
                    </div>
                    <a href="/Lesson/Detail/4" class="clay-btn px-6 py-3 bg-white text-sm font-bold whitespace-nowrap text-boki-blue">Học lại</a>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a href="/Student/Results" class="font-bold text-boki-blue hover:text-boki-purple transition inline-flex items-center gap-2">Xem tất cả lịch sử học tập <i class="fas fa-arrow-right text-xs"></i></a>
            </div>
        </div>
    </section>
</div>
