@model Boki_ELearning.Models.ViewModels.LearningIndexViewModel
@{
    ViewBag.Title = "Học tập";
    var completionPercent = Model.TotalLessons > 0 ? (int)((Model.CompletedLessons * 100.0) / Model.TotalLessons) : 0;
}

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="boki-card p-4">
            <h2 class="fw-bold mb-2">Xin chào, @Model.StudentName</h2>
            <p class="boki-subtitle mb-0">Lớp @Model.ClassName · Tiến độ tổng: @completionPercent%</p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="boki-card p-4">
            <a class="btn btn-outline-primary w-100 mb-2" href="@Url.Action("Index", "StudentExam")">Làm đề tổng hợp</a>
            <small class="boki-subtitle">Bạn có thể làm nhiều lần, hệ thống lấy điểm cao nhất.</small>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="boki-stat">
            <div class="boki-subtitle">Tổng bài học</div>
            <div class="fs-3 fw-bold">@Model.TotalLessons</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="boki-stat">
            <div class="boki-subtitle">Đã hoàn thành</div>
            <div class="fs-3 fw-bold text-success">@Model.CompletedLessons</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="boki-stat">
            <div class="boki-subtitle">Tiến độ</div>
            <div class="fs-3 fw-bold text-primary">@completionPercent%</div>
        </div>
    </div>
</div>

<div class="boki-card p-3 mb-4">
    <h5 class="fw-bold px-2 pt-2">Tiến độ theo môn</h5>
    <div class="row g-3 p-2">
        @foreach (var subject in Model.SubjectProgress ?? new List<Boki_ELearning.Models.ViewModels.SubjectProgressViewModel>())
        {
            var percent = subject.TotalLessons > 0 ? (int)((subject.CompletedLessons * 100.0) / subject.TotalLessons) : 0;
            <div class="col-md-4">
                <div class="border rounded-3 p-3">
                    <div class="fw-semibold">@subject.SubjectName</div>
                    <div class="small text-muted mb-2">@subject.CompletedLessons / @subject.TotalLessons bài</div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar" role="progressbar" style="width:@percent%"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="boki-card p-3">
    <h5 class="fw-bold px-2 pt-2">Danh sách bài học</h5>
    <div class="table-responsive">
        <table class="table boki-table">
            <thead>
                <tr>
                    <th>Bài học</th>
                    <th>Môn học</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Lessons != null && Model.Lessons.Any())
                {
                    foreach (var lesson in Model.Lessons)
                    {
                        <tr>
                            <td>@lesson.LessonName</td>
                            <td>@lesson.SubjectName</td>
                            <td>
                                @if (lesson.IsCompleted)
                                {
                                    <span class="boki-pill boki-pill-success">Đã hoàn thành</span>
                                }
                                else
                                {
                                    <span class="boki-pill boki-pill-warning">Chưa học</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Lesson", "Learning", new { id = lesson.LessonId })">Vào bài</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4">Chưa có bài học.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
