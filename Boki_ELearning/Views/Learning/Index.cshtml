@model Boki_ELearning.Models.ViewModels.LearningIndexViewModel
@using Boki_ELearning.Models.ViewModels
@{
    ViewBag.Title = "Học tập";
    var completionPercent = Model.TotalLessons > 0 ? (int)((Model.CompletedLessons * 100.0) / Model.TotalLessons) : 0;
}

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="boki-card p-4" style="background:linear-gradient(135deg,#3b82f6,#06b6d4);color:#fff;border:none">
            <h2 class="fw-bold mb-1">👋 Xin chào, @Model.StudentName</h2>
            <p style="color:rgba(255,255,255,0.85)" class="mb-2">Lớp hiện tại của bạn: <strong style="color:#fff">@Model.ClassName</strong></p>
            <p class="mb-0" style="color:rgba(255,255,255,0.75)">Bây giờ bạn có thể xem toàn bộ bài học và lọc theo lớp/môn để luyện tập linh hoạt hơn.</p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="boki-card p-4 h-100 d-flex flex-column justify-content-between" style="background:linear-gradient(135deg,#8b5cf6,#ec4899);color:#fff;border:none">
            <div>
                <h6 class="fw-bold mb-2">📝 Đề tổng hợp</h6>
                <p style="color:rgba(255,255,255,0.85)" class="mb-0">Làm đề được giao hoặc tự tạo đề luyện riêng.</p>
            </div>
            <div class="d-flex gap-2 mt-3">
                <a class="btn w-100" style="background:rgba(255,255,255,0.2);color:#fff;border:1px solid rgba(255,255,255,0.3)" href="@Url.Action("Index", "StudentExam")">Vào danh sách đề</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="boki-stat">
            <div class="boki-subtitle">Bài đang hiển thị</div>
            <div class="fs-3 fw-bold">@Model.TotalLessons</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="boki-stat">
            <div class="boki-subtitle">Đã hoàn thành</div>
            <div class="fs-3 fw-bold text-success">@Model.CompletedLessons</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="boki-stat">
            <div class="boki-subtitle">Có trắc nghiệm</div>
            <div class="fs-3 fw-bold text-primary">@Model.LessonsWithQuiz</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="boki-stat">
            <div class="boki-subtitle">Tiến độ</div>
            <div class="fs-3 fw-bold">@completionPercent%</div>
        </div>
    </div>
</div>

<div class="boki-card p-3 mb-4">
    <h5 class="fw-bold px-2 pt-2">🔍 Lọc bài học</h5>
    @using (Html.BeginForm("Index", "Learning", FormMethod.Get, new { @class = "learning-filter-grid p-2" }))
    {
        <div>
            <label class="form-label boki-form-label">Lớp</label>
            <select class="form-select" name="classId">
                <option value="">Tất cả lớp</option>
                @foreach (var option in Model.ClassOptions ?? new List<LearningFilterOptionViewModel>())
                {
                    <option value="@option.Id" @(Model.SelectedClassId == option.Id ? "selected" : "")>@option.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label boki-form-label">Môn học</label>
            <select class="form-select" name="subjectId">
                <option value="">Tất cả môn</option>
                @foreach (var option in Model.SubjectOptions ?? new List<LearningFilterOptionViewModel>())
                {
                    <option value="@option.Id" @(Model.SelectedSubjectId == option.Id ? "selected" : "")>@option.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label boki-form-label">Trắc nghiệm</label>
            <select class="form-select" name="hasQuiz">
                <option value="" @(!Model.SelectedHasQuiz.HasValue ? "selected" : "")>Tất cả</option>
                <option value="true" @(Model.SelectedHasQuiz == true ? "selected" : "")>Chỉ bài có trắc nghiệm</option>
                <option value="false" @(Model.SelectedHasQuiz == false ? "selected" : "")>Chỉ bài chưa có trắc nghiệm</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Áp dụng</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Learning")">Đặt lại</a>
        </div>
    }
    @if (Model.SuggestedClassId.HasValue)
    {
        <div class="px-2 pb-2">
            <a href="@Url.Action("Index", "Learning", new { classId = Model.SuggestedClassId })" class="btn btn-sm btn-outline-primary">
                Lọc nhanh lớp của tôi (@Model.ClassName)
            </a>
        </div>
    }
</div>

<div class="boki-card p-3 mb-4">
    <h5 class="fw-bold px-2 pt-2">📊 Tiến độ theo môn</h5>
    <div class="row g-3 p-2">
        @{ var subjectColors = new[] { "linear-gradient(135deg,#dbeafe,#bfdbfe)", "linear-gradient(135deg,#d1fae5,#a7f3d0)", "linear-gradient(135deg,#fef3c7,#fde68a)", "linear-gradient(135deg,#ede9fe,#ddd6fe)" }; var idx = 0; }
        @foreach (var subject in Model.SubjectProgress ?? new List<SubjectProgressViewModel>())
        {
            var percent = subject.TotalLessons > 0 ? (int)((subject.CompletedLessons * 100.0) / subject.TotalLessons) : 0;
            <div class="col-md-4">
                <div class="rounded-4 p-3 h-100" style="background:@subjectColors[idx % subjectColors.Length]">
                    <div class="fw-bold" style="font-size:1.05rem">@subject.SubjectName</div>
                    <div class="small mb-2" style="color:#475569">@subject.CompletedLessons / @subject.TotalLessons bài · @percent%</div>
                    <div class="progress" style="height:10px;">
                        <div class="progress-bar" role="progressbar" style="width:@percent%"></div>
                    </div>
                </div>
            </div>
            idx++;
        }
    </div>
</div>

<div class="boki-card p-3">
    <h5 class="fw-bold px-2 pt-2">📚 Danh sách bài học</h5>
    <div class="table-responsive">
        <table class="table boki-table">
            <thead>
                <tr>
                    <th>Bài học</th>
                    <th>Lớp</th>
                    <th>Môn học</th>
                    <th>Trắc nghiệm</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Lessons != null && Model.Lessons.Any())
                {
                    foreach (var lesson in Model.Lessons)
                    {
                        <tr>
                            <td>@lesson.LessonName</td>
                            <td>@lesson.ClassName</td>
                            <td>@lesson.SubjectName</td>
                            <td>
                                @if (lesson.QuestionCount > 0)
                                {
                                    <span class="lesson-status"><span class="lesson-status-dot ok"></span>@lesson.QuestionCount câu</span>
                                }
                                else
                                {
                                    <span class="lesson-status"><span class="lesson-status-dot none"></span>Chưa có câu hỏi</span>
                                }
                            </td>
                            <td>
                                @if (lesson.IsCompleted)
                                {
                                    <span class="boki-pill boki-pill-success">Đã hoàn thành</span>
                                }
                                else
                                {
                                    <span class="boki-pill boki-pill-warning">Chưa học</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Lesson", "Learning", new { id = lesson.LessonId })">Vào bài</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="boki-empty">Không có bài học phù hợp bộ lọc hiện tại.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
