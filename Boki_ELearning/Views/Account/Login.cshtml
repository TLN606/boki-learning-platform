@model Boki_ELearning.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div style="text-align:center;margin-bottom:1.2rem">
            <div style="font-size:3rem">🎓</div>
            <h3 class="fw-bold mb-1" style="background:linear-gradient(135deg,#3b82f6,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Đăng nhập</h3>
            <p class="boki-subtitle">Truy cập bài học, quiz và đề tổng hợp của bạn.</p>
        </div>
        <div class="boki-card p-4 p-lg-5">
            @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(x => x.Email, new { @class = "form-label boki-form-label" })
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "student@boki.vn" })
                    @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.Password, new { @class = "form-label boki-form-label" })
                    @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "••••••••" })
                    @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-primary w-100" style="padding:0.7rem;font-size:1rem">🔓 Đăng nhập</button>
            }

            <div class="mt-3 boki-form-help" style="text-align:center">
                Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>.
            </div>
        </div>
    </div>
</div>
