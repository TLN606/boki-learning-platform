@model Boki_ELearning.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div style="text-align:center;margin-bottom:1.2rem">
            <div style="font-size:3rem">🌟</div>
            <h3 class="fw-bold mb-1" style="background:linear-gradient(135deg,#8b5cf6,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Tạo tài khoản học sinh</h3>
            <p class="boki-subtitle">Đăng ký một lần để bắt đầu học và theo dõi tiến độ mỗi ngày.</p>
        </div>
        <div class="boki-card p-4 p-lg-5">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(x => x.FullName, new { @class = "form-label boki-form-label" })
                    @Html.TextBoxFor(x => x.FullName, new { @class = "form-control", placeholder = "Nguyễn Minh Hoàng" })
                    @Html.ValidationMessageFor(x => x.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.ClassId, new { @class = "form-label boki-form-label" })
                    <select class="form-select" name="ClassId">
                        <option value="">-- Chọn lớp --</option>
                        @if (Model.ClassOptions != null)
                        {
                            foreach (var cls in Model.ClassOptions)
                            {
                                <option value="@cls.Id" @(Model.ClassId == cls.Id ? "selected" : "")>@cls.Name</option>
                            }
                        }
                    </select>
                    @Html.ValidationMessageFor(x => x.ClassId, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.Email, new { @class = "form-label boki-form-label" })
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "student@boki.vn" })
                    @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.Password, new { @class = "form-label boki-form-label" })
                    @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự" })
                    @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.ConfirmPassword, new { @class = "form-label boki-form-label" })
                    @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                    @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-primary w-100" style="padding:0.7rem;font-size:1rem">🚀 Đăng ký tài khoản</button>
            }

            <div class="mt-3 boki-form-help" style="text-align:center">
                Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a>.
            </div>
        </div>
    </div>
</div>
