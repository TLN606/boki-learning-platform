@model Boki_ELearning.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="boki-card p-4">
            <h3 class="fw-bold mb-3">Tạo tài khoản học sinh</h3>
            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="mb-3">
                    @Html.LabelFor(x => x.FullName, new { @class = "form-label boki-form-label" })
                    @Html.TextBoxFor(x => x.FullName, new { @class = "form-control", placeholder = "Nguyễn Minh Hoàng" })
                    @Html.ValidationMessageFor(x => x.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.Email, new { @class = "form-label boki-form-label" })
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "student@boki.vn" })
                    @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.Password, new { @class = "form-label boki-form-label" })
                    @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự" })
                    @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(x => x.ConfirmPassword, new { @class = "form-label boki-form-label" })
                    @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                    @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-primary w-100">Đăng ký tài khoản</button>
            }

            <div class="mt-3 boki-form-help">
                Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a>.
            </div>
        </div>
    </div>
</div>
