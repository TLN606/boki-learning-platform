@model Boki_ELearning.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - Boki</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Nunito', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#ecfdf5', 100: '#d1fae5', 500: '#10b981', 600: '#059669', 900: '#064e3b' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/Content/templates/boki-frontend/assets/css/style.css">
    <script src="/Content/templates/boki-frontend/assets/js/theme.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 flex flex-col min-h-screen relative p-4 sm:p-8">
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-[-1]">
        <div class="floating-bg-shape bg-emerald-400 dark:bg-emerald-600 w-96 h-96 top-[-100px] right-[-100px]"></div>
        <div class="floating-bg-shape bg-yellow-400 dark:bg-yellow-600 w-96 h-96 bottom-[-100px] left-[-100px]"></div>
    </div>

    <div class="fixed top-4 left-4 right-4 z-50 flex justify-between pointer-events-none">
        <a href="@Url.Action("Index", "Home")" class="pointer-events-auto flex items-center gap-2 p-2 px-4 rounded-full bg-white/70 dark:bg-slate-800/70 backdrop-blur-md shadow-sm border border-white/50 dark:border-slate-700/50 text-slate-600 dark:text-slate-300 hover:text-brand-500 dark:hover:text-brand-400 font-bold transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Trang chủ
        </a>
        <button id="theme-toggle" class="pointer-events-auto p-2 rounded-full bg-white/70 dark:bg-slate-800/70 backdrop-blur-md shadow-sm border border-white/50 dark:border-slate-700/50 hover:bg-white dark:hover:bg-slate-700 transition cursor-pointer text-slate-600 dark:text-slate-300">
            <svg id="theme-toggle-light-icon" class="w-6 h-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            <svg id="theme-toggle-dark-icon" class="w-6 h-6 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        </button>
    </div>

    <div class="flex-grow flex items-center justify-center my-12 relative z-10 w-full">
        <div class="clay-card bg-white dark:bg-slate-800 p-8 sm:p-10 max-w-lg w-full transition-transform duration-300 hover:scale-[1.01] flex flex-col items-center">
            @if (TempData["Message"] != null)
            {
                <div class="mb-4 w-full rounded-xl bg-emerald-100 text-emerald-700 font-bold text-sm px-4 py-3">
                    @TempData["Message"]
                </div>
            }
            <div class="text-center mb-8">
                <h1 class="text-3xl font-black text-slate-800 dark:text-white tracking-tight mb-2">Tạo tài khoản</h1>
                <p class="text-slate-500 dark:text-slate-400 font-medium">Tham gia với 10,000+ bé!</p>
            </div>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "space-y-5 w-full" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, string.Empty, new { @class = "text-sm text-red-500 font-bold bg-red-50 dark:bg-red-900/20 rounded-xl px-4 py-3" })

                <div class="relative">
                    <label class="block text-slate-700 dark:text-slate-300 font-bold mb-1 ml-2 text-sm" for="fullName">Họ và tên bé</label>
                    <div class="relative">
                        <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        @Html.TextBoxFor(x => x.FullName, new { id = "fullName", @class = "clay-input", placeholder = "Ví dụ: Nguyễn Minh Hoàng" })
                    </div>
                    @Html.ValidationMessageFor(x => x.FullName, string.Empty, new { @class = "text-sm text-red-500 font-semibold mt-2 block" })
                </div>

                <div class="relative">
                    <label class="block text-slate-700 dark:text-slate-300 font-bold mb-1 ml-2 text-sm" for="email">Email</label>
                    <div class="relative">
                        <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        @Html.TextBoxFor(x => x.Email, new { id = "email", @class = "clay-input", placeholder = "student@boki.vn", type = "email" })
                    </div>
                    @Html.ValidationMessageFor(x => x.Email, string.Empty, new { @class = "text-sm text-red-500 font-semibold mt-2 block" })
                </div>

                <div class="relative">
                    <label class="block text-slate-700 dark:text-slate-300 font-bold mb-1 ml-2 text-sm" for="password">Mật khẩu</label>
                    <div class="relative">
                        <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        @Html.PasswordFor(x => x.Password, new { id = "password", @class = "clay-input", placeholder = "••••••••" })
                    </div>
                    @Html.ValidationMessageFor(x => x.Password, string.Empty, new { @class = "text-sm text-red-500 font-semibold mt-2 block" })
                </div>

                <div class="relative">
                    <label class="block text-slate-700 dark:text-slate-300 font-bold mb-1 ml-2 text-sm" for="confirmPassword">Xác nhận mật khẩu</label>
                    <div class="relative">
                        <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        @Html.PasswordFor(x => x.ConfirmPassword, new { id = "confirmPassword", @class = "clay-input", placeholder = "••••••••" })
                    </div>
                    @Html.ValidationMessageFor(x => x.ConfirmPassword, string.Empty, new { @class = "text-sm text-red-500 font-semibold mt-2 block" })
                </div>

                <button type="submit" class="clay-btn-green text-xl mt-6 w-full py-4 flex items-center justify-center gap-2">
                    Đăng ký hoàn tất!
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </button>
            }

            <div class="mt-8 text-center text-slate-500 dark:text-slate-400 font-medium text-sm w-full border-t border-slate-100 dark:border-slate-700 pt-6">
                Đã có tài khoản? <a href="@Url.Action("Login", "Account")" class="text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 font-bold transition">Đăng nhập</a>
            </div>
        </div>
    </div>
</body>
</html>
