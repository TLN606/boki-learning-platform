@model Boki_ELearning.Models.ViewModels.LessonAdminEditorViewModel
@{
    Layout = "~/Views/Layouts/_AdminLayout.cshtml";
    ViewBag.Title = Model.LessonId.HasValue ? "Sửa bài học" : "Thêm bài học";
    ViewBag.AdminNav = "lessons";
}

<div class="admin-card p-3" style="max-width: 980px;">
    <h6 class="fw-bold mb-3">@ViewBag.Title</h6>

    @if (!Model.ClassOptions.Any() || !Model.SubjectOptions.Any())
    {
        <div class="alert alert-warning mb-0">Cần có dữ liệu lớp và môn học trước khi tạo bài học.</div>
    }
    else
    {
        using (Html.BeginForm("Save", "LessonAdmin", FormMethod.Post, new { id = "lessonEditorForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.LessonId)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-2">
                <label class="form-label boki-form-label" for="LessonName">Tên bài học</label>
                @Html.TextBoxFor(x => x.LessonName, new { @class = "form-control", maxlength = "255", required = "required" })
                @Html.ValidationMessageFor(x => x.LessonName, "", new { @class = "text-danger small" })
            </div>

            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label boki-form-label" for="ClassId">Lớp</label>
                    @Html.DropDownListFor(x => x.ClassId, new SelectList(Model.ClassOptions, "Id", "Name", Model.ClassId), "-- Chọn lớp --", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(x => x.ClassId, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label class="form-label boki-form-label" for="SubjectId">Môn học</label>
                    @Html.DropDownListFor(x => x.SubjectId, new SelectList(Model.SubjectOptions, "Id", "Name", Model.SubjectId), "-- Chọn môn học --", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(x => x.SubjectId, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label boki-form-label">Nội dung bài học</label>
                <div id="lessonTheoryEditor" class="js-lesson-editor d-none">@Html.Raw(Model.TheoryContent)</div>
                @Html.TextAreaFor(x => x.TheoryContent, new { @class = "form-control", id = "TheoryContent", rows = "8" })
                @Html.ValidationMessageFor(x => x.TheoryContent, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label boki-form-label">Mẹo ghi nhớ</label>
                <div id="lessonTipEditor" class="js-lesson-editor d-none">@Html.Raw(Model.TipContent)</div>
                @Html.TextAreaFor(x => x.TipContent, new { @class = "form-control", id = "TipContent", rows = "5" })
                @Html.ValidationMessageFor(x => x.TipContent, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn btn-primary">Lưu bài học</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "LessonAdmin")">Quay lại danh sách</a>
        }
    }
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/43.0.0/ckeditor5.css" />
    <style>
        .ck-editor__editable_inline {
            min-height: 280px;
        }

        #lessonTipEditor + .ck-editor .ck-editor__editable_inline {
            min-height: 180px;
        }
    </style>
    <script src="https://cdn.ckeditor.com/ckeditor5/43.0.0/ckeditor5.umd.js"></script>
    <script>
        (function () {
            var form = document.getElementById('lessonEditorForm');
            if (!form || typeof CKEDITOR === 'undefined' || !CKEDITOR.ClassicEditor) {
                return;
            }

            var uploadUrl = '@Url.Action("UploadMedia", "LessonAdmin")';
            var editors = [];

            function getAntiForgeryToken() {
                var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            function BokiUploadAdapter(loader) {
                this.loader = loader;
            }

            BokiUploadAdapter.prototype.upload = function () {
                return this.loader.file.then(function (file) {
                    var data = new FormData();
                    data.append('upload', file);
                    data.append('__RequestVerificationToken', getAntiForgeryToken());

                    return fetch(uploadUrl, {
                        method: 'POST',
                        body: data,
                        credentials: 'same-origin'
                    })
                        .then(function (response) {
                            if (!response.ok) {
                                throw new Error('upload_failed');
                            }

                            return response.json();
                        })
                        .then(function (result) {
                            if (!result || !result.url) {
                                throw new Error('upload_failed');
                            }

                            return {
                                default: result.url
                            };
                        });
                });
            };

            BokiUploadAdapter.prototype.abort = function () {
            };

            function useBokiUploadAdapter(editor) {
                editor.plugins.get('FileRepository').createUploadAdapter = function (loader) {
                    return new BokiUploadAdapter(loader);
                };
            }

            var editorConfig = {
                licenseKey: 'GPL',
                plugins: [
                    CKEDITOR.Essentials,
                    CKEDITOR.Paragraph,
                    CKEDITOR.Heading,
                    CKEDITOR.Bold,
                    CKEDITOR.Italic,
                    CKEDITOR.Underline,
                    CKEDITOR.Strikethrough,
                    CKEDITOR.Link,
                    CKEDITOR.List,
                    CKEDITOR.BlockQuote,
                    CKEDITOR.Alignment,
                    CKEDITOR.Font,
                    CKEDITOR.Image,
                    CKEDITOR.ImageCaption,
                    CKEDITOR.ImageResize,
                    CKEDITOR.ImageStyle,
                    CKEDITOR.ImageToolbar,
                    CKEDITOR.ImageUpload,
                    CKEDITOR.MediaEmbed,
                    CKEDITOR.Table,
                    CKEDITOR.TableToolbar,
                    useBokiUploadAdapter
                ],
                toolbar: {
                    items: [
                        'undo', 'redo', '|',
                        'heading', '|',
                        'bold', 'italic', 'underline', 'strikethrough', '|',
                        'fontColor', 'fontBackgroundColor', '|',
                        'alignment', '|',
                        'bulletedList', 'numberedList', '|',
                        'link', 'blockQuote', 'insertTable', 'mediaEmbed', 'uploadImage'
                    ],
                    shouldNotGroupWhenFull: true
                },
                image: {
                    toolbar: [
                        'imageTextAlternative', 'toggleImageCaption', '|',
                        'imageStyle:inline', 'imageStyle:alignLeft', 'imageStyle:alignCenter', 'imageStyle:alignRight', '|',
                        'imageStyle:block', 'imageStyle:side', '|',
                        'resizeImage'
                    ]
                },
                mediaEmbed: {
                    previewsInData: true
                },
                table: {
                    contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells']
                }
            };

            function createEditor(editorElementId, textareaId) {
                var editorElement = document.getElementById(editorElementId);
                var textarea = document.getElementById(textareaId);
                if (!editorElement || !textarea) {
                    return;
                }

                editorElement.classList.remove('d-none');
                CKEDITOR.ClassicEditor
                    .create(editorElement, editorConfig)
                    .then(function (editor) {
                        editors.push({
                            editor: editor,
                            textarea: textarea
                        });
                        textarea.classList.add('d-none');
                    })
                    .catch(function (error) {
                        textarea.classList.remove('d-none');
                        editorElement.classList.add('d-none');
                        console.error(error);
                    });
            }

            createEditor('lessonTheoryEditor', 'TheoryContent');
            createEditor('lessonTipEditor', 'TipContent');

            form.addEventListener('submit', function () {
                for (var i = 0; i < editors.length; i++) {
                    editors[i].textarea.value = editors[i].editor.getData();
                }
            });
        })();
    </script>
}
