@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi" class="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boki - Học vui mỗi ngày!</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Nunito', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6', 600: '#2563eb', 900: '#1e3a8a' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/Content/templates/boki-frontend/assets/css/style.css">
    <script src="/Content/templates/boki-frontend/assets/js/theme.js"></script>
</head>

<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 flex flex-col min-h-screen relative">
    <!-- Background Ornaments -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-[-1]">
        <div class="floating-bg-shape bg-blue-300 dark:bg-blue-600 w-96 h-96 top-[-100px] left-[-100px]"></div>
        <div class="floating-bg-shape bg-pink-300 dark:bg-pink-600 w-80 h-80 top-[30%] right-[-50px]"></div>
        <div class="floating-bg-shape bg-yellow-300 dark:bg-yellow-600 w-[500px] h-[500px] bottom-[-200px] left-[20%]"></div>
    </div>

    <div class="fixed top-4 left-4 right-4 z-50 flex justify-center pointer-events-none">
        <nav
            class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between bg-white/70 dark:bg-slate-800/70 backdrop-blur-lg rounded-full shadow-[0_4px_24px_rgba(0,0,0,0.06)] dark:shadow-[0_4px_24px_rgba(0,0,0,0.4)] border border-white/50 dark:border-slate-700/50 pointer-events-auto transition-all">
            <div class="flex items-center gap-3">
                <div
                    class="w-10 h-10 bg-brand-500 rounded-full flex items-center justify-center text-xl font-black text-white shadow-md">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253">
                        </path>
                    </svg>
                </div>
                <span class="text-2xl font-black text-slate-800 dark:text-white tracking-tight">Boki</span>
            </div>
            <div class="flex items-center gap-4">
                <button id="theme-toggle"
                    class="p-2 rounded-full hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer text-slate-600 dark:text-slate-300">
                    <!-- Sun icon -->
                    <svg id="theme-toggle-light-icon" class="w-6 h-6 hidden dark:block" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z">
                        </path>
                    </svg>
                    <!-- Moon icon -->
                    <svg id="theme-toggle-dark-icon" class="w-6 h-6 block dark:hidden" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z">
                        </path>
                    </svg>
                </button>
                <a href="@Url.Action("Login","Account")"
                    class="font-bold text-slate-600 dark:text-slate-300 hover:text-brand-500 dark:hover:text-brand-400 transition cursor-pointer hidden sm:block">Đăng
                    nhập</a>
                <a href="@Url.Action("Register","Account")" class="clay-btn-primary px-5 py-2 text-sm">Đăng Ký</a>
            </div>
        </nav>
    </div>

    <main class="flex-grow pt-28">
        <!-- Hero Section -->
        <section class="container mx-auto px-6 py-12 md:py-20 text-center">
            <div
                class="inline-flex items-center gap-2 mb-6 px-4 py-2 bg-white/60 dark:bg-slate-800/60 backdrop-blur-md rounded-full text-brand-600 dark:text-brand-400 font-bold text-sm shadow-sm border border-white/50 dark:border-slate-700/50">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                Nền tảng học tập vui nhộn số 1
            </div>
            <h1
                class="text-5xl md:text-7xl font-black text-slate-800 dark:text-white mb-6 leading-tight drop-shadow-sm">
                Học vui mỗi ngày! <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-pink-500 dark:from-blue-400 dark:to-pink-400">Giỏi
                    toán, văn, anh</span>
            </h1>
            <p
                class="text-lg md:text-xl text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mb-10 font-medium leading-relaxed">
                Dành riêng cho học sinh tiểu học (Lớp 2 - Lớp 5). Giúp bé tiếp thu kiến thức một cách tự nhiên qua các
                bài học tương tác.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="@Url.Action("Register","Account")"
                    class="clay-btn-primary px-8 py-4 text-lg w-full sm:w-auto inline-flex items-center justify-center gap-2">
                    Bắt đầu học ngay
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
                <a href="#features"
                    class="clay-btn-secondary px-8 py-4 text-lg w-full sm:w-auto inline-flex items-center justify-center gap-2">
                    Tìm hiểu thêm
                    <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                </a>
            </div>

            <!-- Dashboard Mockup -->
            <div
                class="mt-20 mx-auto max-w-4xl clay-card bg-white dark:bg-slate-800 p-2 md:p-4 rotate-1 hover:rotate-0 transition-transform duration-500">
                <div
                    class="bg-slate-50 dark:bg-slate-900 rounded-xl overflow-hidden border border-slate-100 dark:border-slate-700 flex flex-col relative w-full aspect-video shadow-inner">
                    <div
                        class="h-8 bg-slate-200 dark:bg-slate-800 flex items-center px-4 gap-2 border-b border-slate-300 dark:border-slate-700">
                        <div class="w-3 h-3 rounded-full bg-rose-400"></div>
                        <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                        <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                    </div>
                    <div class="flex-1 p-6 flex flex-col gap-6">
                        <div class="flex gap-4 items-center">
                            <div class="w-12 h-12 bg-slate-200 dark:bg-slate-700 rounded-full animate-pulse"></div>
                            <div class="h-6 w-1/3 bg-slate-200 dark:bg-slate-700 rounded-lg animate-pulse"></div>
                        </div>
                        <div class="flex gap-4 flex-1">
                            <div class="flex-1 clay-card-blue bg-blue-50 dark:bg-blue-900/30 opacity-70"></div>
                            <div class="flex-1 clay-card-pink bg-pink-50 dark:bg-pink-900/30 opacity-70"></div>
                            <div class="flex-1 clay-card-yellow bg-yellow-50 dark:bg-yellow-900/30 opacity-70"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="py-24 bg-slate-100/50 dark:bg-slate-800/30">
            <div class="container mx-auto px-6">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-4xl font-black text-slate-800 dark:text-white mb-4">Mọi thứ bé cần để
                        tiến bộ</h2>
                    <p class="text-slate-500 dark:text-slate-400 font-bold">Phương pháp học tập mới mẻ, kích thích trí
                        tò mò.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div
                        class="clay-card bg-white dark:bg-slate-800 p-8 text-center flex flex-col items-center hover:-translate-y-2 cursor-pointer">
                        <div
                            class="w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/50 text-brand-500 dark:text-brand-400 flex items-center justify-center mb-6 shadow-inner">
                            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z">
                                </path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-black text-slate-800 dark:text-white mb-3">Lý thuyết rõ ràng</h3>
                        <p class="text-slate-500 dark:text-slate-400 font-medium leading-relaxed">Bản đồ tư duy sinh
                            động giúp bé nắm bắt siêu tốc các khái niệm phức tạp.</p>
                    </div>

                    <div
                        class="clay-card bg-white dark:bg-slate-800 p-8 text-center flex flex-col items-center hover:-translate-y-2 cursor-pointer">
                        <div
                            class="w-20 h-20 rounded-full bg-pink-100 dark:bg-pink-900/50 text-pink-500 flex items-center justify-center mb-6 shadow-inner">
                            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-black text-slate-800 dark:text-white mb-3">Trắc nghiệm tự động</h3>
                        <p class="text-slate-500 dark:text-slate-400 font-medium leading-relaxed">Chấm điểm tức thì tạo
                            sự ganh đua thú vị, bé càng làm càng mê.</p>
                    </div>

                    <div
                        class="clay-card bg-white dark:bg-slate-800 p-8 text-center flex flex-col items-center hover:-translate-y-2 cursor-pointer">
                        <div
                            class="w-20 h-20 rounded-full bg-yellow-100 dark:bg-yellow-900/50 text-yellow-500 flex items-center justify-center mb-6 shadow-inner">
                            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z">
                                </path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-black text-slate-800 dark:text-white mb-3">Phản hồi chi tiết</h3>
                        <p class="text-slate-500 dark:text-slate-400 font-medium leading-relaxed">Giải thích tận tình
                            từng câu sai để bé rút kinh nghiệm ngay lập tức.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Course Catalog -->
        <section class="py-24 container mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-black text-slate-800 dark:text-white mb-4">Các môn học cốt lõi</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
                <div
                    class="clay-card-blue bg-blue-50/50 dark:bg-slate-800 p-8 flex flex-col items-center text-center cursor-pointer group">
                    <div
                        class="w-24 h-24 bg-white dark:bg-slate-700 rounded-full flex items-center justify-center text-brand-500 mb-6 shadow-sm group-hover:scale-110 transition shrink-0">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z">
                            </path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-black text-blue-900 dark:text-blue-100 mb-2">Toán học vui</h3>
                    <p class="text-blue-700 dark:text-blue-300 font-medium mb-8">Lớp 2 đến Lớp 5</p>
                    <a href="@Url.Action("Register","Account")"
                        class="clay-btn-primary bg-blue-500 w-full py-3 mt-auto inline-block text-center">Khám phá</a>
                </div>

                <div
                    class="clay-card-pink bg-pink-50/50 dark:bg-slate-800 p-8 flex flex-col items-center text-center cursor-pointer group">
                    <div
                        class="w-24 h-24 bg-white dark:bg-slate-700 rounded-full flex items-center justify-center text-pink-500 mb-6 shadow-sm group-hover:scale-110 transition shrink-0">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253">
                            </path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-black text-pink-900 dark:text-pink-100 mb-2">Tiếng Việt</h3>
                    <p class="text-pink-700 dark:text-pink-300 font-medium mb-8">Lớp 2 đến Lớp 5</p>
                    <a href="@Url.Action("Register","Account")"
                        class="clay-btn-primary bg-pink-500 dark:bg-pink-600 w-full py-3 mt-auto inline-block text-center shadow-pink-500/40">Khám
                        phá</a>
                </div>

                <div
                    class="clay-card-yellow bg-yellow-50/50 dark:bg-slate-800 p-8 flex flex-col items-center text-center cursor-pointer group">
                    <div
                        class="w-24 h-24 bg-white dark:bg-slate-700 rounded-full flex items-center justify-center text-yellow-500 mb-6 shadow-sm group-hover:scale-110 transition shrink-0">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-black text-yellow-900 dark:text-yellow-100 mb-2">Tiếng Anh</h3>
                    <p class="text-yellow-700 dark:text-yellow-300 font-medium mb-8">Lớp 2 đến Lớp 5</p>
                    <a href="@Url.Action("Register","Account")"
                        class="clay-btn-primary bg-yellow-500 dark:bg-yellow-600 text-yellow-900 dark:text-white w-full py-3 mt-auto inline-block text-center shadow-yellow-500/40">Khám
                        phá</a>
                </div>
            </div>
        </section>

        <!-- Parent Reviews -->
        <section class="py-24 bg-slate-100/50 dark:bg-slate-800/30">
            <div class="container mx-auto px-6">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-4xl font-black text-slate-800 dark:text-white mb-4">Phụ huynh nói gì về
                        Boki?</h2>
                    <p class="text-slate-500 dark:text-slate-400 font-bold">Hàng ngàn cha mẹ đã tin tưởng và đồng hành
                        cùng bé.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                    <!-- Review 1 -->
                    <div class="clay-card bg-white dark:bg-slate-800 p-8 relative cursor-pointer hover:-translate-y-1">
                        <svg class="w-16 h-16 absolute -top-4 -left-4 text-slate-200 dark:text-slate-700 fill-current opacity-50"
                            viewBox="0 0 24 24">
                            <path
                                d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                        </svg>
                        <div class="flex items-center gap-4 mb-6 relative z-10">
                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Mom1&backgroundColor=fce7f3"
                                alt="Avatar"
                                class="w-14 h-14 rounded-full border-2 border-white dark:border-slate-700 shadow-sm bg-pink-100">
                            <div>
                                <h4 class="font-black text-slate-800 dark:text-white">Chị Thu Thủy</h4>
                                <p class="text-sm font-bold text-slate-400 dark:text-slate-500">Phụ huynh bé Mai Anh
                                    (Lớp 2)</p>
                            </div>
                        </div>
                        <p class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed italic relative z-10">
                            "Từ ngày cho con học Boki, bé tự giác hẳn lên. Màu sắc rực rỡ và có các bài tập tương tác
                            làm con bé mê tít. Môn Toán không còn là nỗi sợ nữa."</p>
                        <div class="text-yellow-400 dark:text-yellow-500 text-lg mt-4 flex gap-1">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                                <path
