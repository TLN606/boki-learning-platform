@model List<Boki_ELearning.Models.ViewModels.StudentExamListItemViewModel>
@{
    ViewBag.Title = "Đề thi tổng hợp";
}

<div class="boki-card p-4 mb-3">
    <h3 class="fw-bold mb-2">Danh sách đề thi được giao</h3>
    <p class="boki-subtitle mb-0">Bạn có thể làm nhiều lần, hệ thống sẽ lấy điểm cao nhất.</p>
</div>

<div class="boki-card p-3">
    <div class="table-responsive">
        <table class="table boki-table">
            <thead>
                <tr>
                    <th>Mã đề</th>
                    <th>Tên đề</th>
                    <th>Số câu</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th>Điểm cao nhất</th>
                    <th>Số lần làm</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ExamId</td>
                        <td>@item.ExamName</td>
                        <td>@item.QuestionCount</td>
                        <td>@item.DurationMinutes phút</td>
                        <td>@item.Status</td>
                        <td>@(item.BestScore.HasValue ? item.BestScore.Value.ToString("0.##") : "-")</td>
                        <td>@item.AttemptCount</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Take", "StudentExam", new { id = item.ExamId })">Làm đề</a>
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("History", "StudentExam", new { id = item.ExamId })">Lịch sử</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
