@model Boki_ELearning.Models.ViewModels.StudentExamHistoryViewModel
@{
    ViewBag.Title = "Lịch sử làm đề";
}

<div class="boki-card p-4 mb-3">
    <h3 class="fw-bold mb-1">@Model.ExamName</h3>
    <div class="boki-subtitle">Điểm cao nhất: @(Model.BestScore.HasValue ? Model.BestScore.Value.ToString("0.##") + "/10" : "Chưa có")</div>
</div>

<div class="boki-card p-3 mb-3">
    <div class="table-responsive">
        <table class="table boki-table">
            <thead>
                <tr>
                    <th>Lần làm</th>
                    <th>Điểm</th>
                    <th>Đúng/Tổng</th>
                    <th>Thời gian nộp</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Attempts.Any())
                {
                    foreach (var item in Model.Attempts)
                    {
                        <tr>
                            <td>#@item.AttemptId</td>
                            <td>@item.Score.ToString("0.##")</td>
                            <td>@item.CorrectCount/@item.TotalCount</td>
                            <td>@item.SubmitAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">Bạn chưa làm đề này.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    <a class="btn btn-primary" href="@Url.Action("Take", "StudentExam", new { id = Model.ExamId })">Làm lại đề</a>
    <a class="btn btn-outline-secondary" href="@Url.Action("Index", "StudentExam")">Quay lại danh sách</a>
</div>
