@model Boki_ELearning.Models.ViewModels.QuestionBankPageViewModel
@{
    Layout = "~/Views/Layouts/_AdminLayout.cshtml";
    ViewBag.Title = "Tạo câu hỏi";
    ViewBag.AdminNav = "questions";
}

<div class="admin-card p-3" style="max-width: 860px;">
    <h6 class="fw-bold mb-3">Tạo câu hỏi mới</h6>

    @if (!Model.LessonOptions.Any())
    {
        <div class="alert alert-warning mb-0">Chưa có bài học khả dụng. Hãy tạo bài học trước rồi thêm câu hỏi.</div>
    }
    else
    {
        using (Html.BeginForm("Save", "QuestionBank", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("QuestionId", Model.Editor.QuestionId)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-2">
                <label class="form-label boki-form-label">Bài học</label>
                <select class="form-select" name="LessonId" required>
                    <option value="">-- Chọn bài học --</option>
                    @foreach (var option in Model.LessonOptions)
                    {
                        <option value="@option.LessonId" @(option.LessonId == Model.Editor.LessonId ? "selected" : "")>@option.LessonDisplay</option>
                    }
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label boki-form-label">Nội dung câu hỏi</label>
                <div id="createQuestionEditor" class="js-question-editor d-none">@Html.Raw(Model.Editor.QuestionText)</div>
                <textarea class="form-control" id="createQuestionText" name="QuestionText" rows="6">@Model.Editor.QuestionText</textarea>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label boki-form-label">Độ khó</label>
                    <select class="form-select" name="Difficulty">
                        <option value="De" @(Model.Editor.Difficulty == "De" ? "selected" : "")>Dễ</option>
                        <option value="TrungBinh" @(Model.Editor.Difficulty == "TrungBinh" ? "selected" : "")>Trung bình</option>
                        <option value="Kho" @(Model.Editor.Difficulty == "Kho" ? "selected" : "")>Khó</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label boki-form-label">Trạng thái</label>
                    <select class="form-select" name="Status">
                        <option value="Active" @(Model.Editor.Status == "Active" ? "selected" : "")>Active</option>
                        <option value="Draft" @(Model.Editor.Status == "Draft" ? "selected" : "")>Draft</option>
                    </select>
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label boki-form-label">Đáp án A</label>
                <input class="form-control" name="AnswerA" value="@Model.Editor.AnswerA" required />
            </div>
            <div class="mb-2">
                <label class="form-label boki-form-label">Đáp án B</label>
                <input class="form-control" name="AnswerB" value="@Model.Editor.AnswerB" required />
            </div>
            <div class="mb-2">
                <label class="form-label boki-form-label">Đáp án C</label>
                <input class="form-control" name="AnswerC" value="@Model.Editor.AnswerC" required />
            </div>
            <div class="mb-2">
                <label class="form-label boki-form-label">Đáp án D</label>
                <input class="form-control" name="AnswerD" value="@Model.Editor.AnswerD" required />
            </div>

            <div class="mb-3">
                <label class="form-label boki-form-label">Đáp án đúng</label>
                <select class="form-select" name="CorrectIndex">
                    <option value="0" @(Model.Editor.CorrectIndex == 0 ? "selected" : "")>A</option>
                    <option value="1" @(Model.Editor.CorrectIndex == 1 ? "selected" : "")>B</option>
                    <option value="2" @(Model.Editor.CorrectIndex == 2 ? "selected" : "")>C</option>
                    <option value="3" @(Model.Editor.CorrectIndex == 3 ? "selected" : "")>D</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Lưu câu hỏi</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "QuestionBank")">Quay lại danh sách</a>
        }
    }
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/43.0.0/ckeditor5.css" />
    <style>
        .ck-editor__editable_inline {
            min-height: 260px;
        }
    </style>
    <script src="https://cdn.ckeditor.com/ckeditor5/43.0.0/ckeditor5.umd.js"></script>
    <script>
        (function () {
            var editorElement = document.getElementById('createQuestionEditor');
            var textarea = document.getElementById('createQuestionText');
            if (!editorElement || !textarea || typeof CKEDITOR === 'undefined' || !CKEDITOR.ClassicEditor) {
                return;
            }

            var uploadUrl = '@Url.Action("UploadMedia", "QuestionBank")';
            var editorInstance = null;

            function getAntiForgeryToken() {
                var tokenInput = textarea.form ? textarea.form.querySelector('input[name="__RequestVerificationToken"]') : null;
                return tokenInput ? tokenInput.value : '';
            }

            function BokiUploadAdapter(loader) {
                this.loader = loader;
            }

            BokiUploadAdapter.prototype.upload = function () {
                return this.loader.file.then(function (file) {
                    var data = new FormData();
                    data.append('upload', file);
                    data.append('__RequestVerificationToken', getAntiForgeryToken());

                    return fetch(uploadUrl, {
                        method: 'POST',
                        body: data,
                        credentials: 'same-origin'
                    })
                        .then(function (response) {
                            if (!response.ok) {
                                throw new Error('upload_failed');
                            }

                            return response.json();
                        })
                        .then(function (result) {
                            if (!result || !result.url) {
                                throw new Error('upload_failed');
                            }

                            return {
                                default: result.url
                            };
                        });
                });
            };

            BokiUploadAdapter.prototype.abort = function () {
            };

            function useBokiUploadAdapter(editor) {
                editor.plugins.get('FileRepository').createUploadAdapter = function (loader) {
                    return new BokiUploadAdapter(loader);
                };
            }

            var editorConfig = {
                licenseKey: 'GPL',
                plugins: [
                    CKEDITOR.Essentials,
                    CKEDITOR.Paragraph,
                    CKEDITOR.Heading,
                    CKEDITOR.Bold,
                    CKEDITOR.Italic,
                    CKEDITOR.Underline,
                    CKEDITOR.Strikethrough,
                    CKEDITOR.Link,
                    CKEDITOR.List,
                    CKEDITOR.BlockQuote,
                    CKEDITOR.Alignment,
                    CKEDITOR.Font,
                    CKEDITOR.Image,
                    CKEDITOR.ImageCaption,
                    CKEDITOR.ImageResize,
                    CKEDITOR.ImageStyle,
                    CKEDITOR.ImageToolbar,
                    CKEDITOR.ImageUpload,
                    CKEDITOR.MediaEmbed,
                    CKEDITOR.Table,
                    CKEDITOR.TableToolbar,
                    useBokiUploadAdapter
                ],
                toolbar: {
                    items: [
                        'undo', 'redo', '|',
                        'heading', '|',
                        'bold', 'italic', 'underline', 'strikethrough', '|',
                        'fontColor', 'fontBackgroundColor', '|',
                        'alignment', '|',
                        'bulletedList', 'numberedList', '|',
                        'link', 'blockQuote', 'insertTable', 'mediaEmbed', 'uploadImage'
                    ],
                    shouldNotGroupWhenFull: true
                },
                image: {
                    toolbar: [
                        'imageTextAlternative', 'toggleImageCaption', '|',
                        'imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|',
                        'resizeImage'
                    ]
                },
                table: {
                    contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells']
                }
            };

            editorElement.classList.remove('d-none');

            CKEDITOR.ClassicEditor
                .create(editorElement, editorConfig)
                .then(function (editor) {
                    editorInstance = editor;
                    textarea.classList.add('d-none');
                })
                .catch(function (error) {
                    editorElement.classList.add('d-none');
                    textarea.classList.remove('d-none');
                    console.error(error);
                });

            var form = textarea.form;
            if (!form) {
                return;
            }

            form.addEventListener('submit', function () {
                if (editorInstance) {
                    textarea.value = editorInstance.getData();
                }
            });
        })();
    </script>
}
