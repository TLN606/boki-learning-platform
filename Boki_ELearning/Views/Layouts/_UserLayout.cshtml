@using Boki_ELearning.Helpers
@{
    var isLoggedIn = Session[SessionKeys.AccountId] != null;
    var role = Session[SessionKeys.Role] as string;
    var studentName = Session[SessionKeys.StudentName] as string ?? "Học sinh";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Boki ELearning</title>
    @Styles.Render("~/Content/css")
</head>
<body>
    <nav class="navbar navbar-expand-lg boki-navbar">
        <div class="container">
            <a class="navbar-brand boki-brand" href="@Url.Action("Index", "Home")">Boki ELearning</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bokiNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="bokiNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                    @if (isLoggedIn)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Learning")">Học tập</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "StudentExam")">Đề tổng hợp</a></li>
                        if (RoleHelper.IsAdmin(role))
                        {
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Dashboard", "Admin")">Quản lý</a></li>
                        }
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (isLoggedIn)
                    {
                        <li class="nav-item"><span class="nav-link">Xin chào, @studentName</span></li>
                        <li class="nav-item"><a class="btn btn-outline-secondary btn-sm mt-1" href="@Url.Action("Logout", "Account")">Đăng xuất</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-outline-primary btn-sm mt-1 me-2" href="@Url.Action("Login", "Account")">Đăng nhập</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm mt-1" href="@Url.Action("Register", "Account")">Đăng ký</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="boki-main">
        <div class="container">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info">@TempData["Message"]</div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="border-top bg-white py-3">
        <div class="container footer-note">
            &copy; @DateTime.Now.Year Boki ELearning
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
</body>
</html>
