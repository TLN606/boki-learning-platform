<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Boki Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />
    @Styles.Render("~/Content/css")
</head>
<body>
    <div class="admin-shell boki-page-enter">
        <aside class="admin-sidebar">
            <div class="logo">Boki Admin</div>
            <a class="admin-link @(ViewBag.AdminNav == "dashboard" ? "active" : "")" href="@Url.Action("Dashboard", "Admin")">Tổng quan</a>
            <a class="admin-link @(ViewBag.AdminNav == "students" ? "active" : "")" href="@Url.Action("Students", "Admin")">Học sinh</a>
            <a class="admin-link @(ViewBag.AdminNav == "results" ? "active" : "")" href="@Url.Action("Results", "Admin")">Kết quả học tập</a>
            <a class="admin-link @(ViewBag.AdminNav == "lessons" ? "active" : "")" href="@Url.Action("Index", "AdminLesson")">Quản lý bài học</a>
            <hr class="border-secondary-subtle my-2" />
            <span class="admin-link-group-label">Ngân hàng câu hỏi</span>
            <a class="admin-link admin-link-sub @(ViewBag.AdminNav == "questions" && ViewBag.AdminSubject as string == "toán" ? "active" : "")" href="@Url.Action("Index", "QuestionBank", new { subject = "toán" })">📐 NH Toán</a>
            <a class="admin-link admin-link-sub @(ViewBag.AdminNav == "questions" && ViewBag.AdminSubject as string == "tiếng việt" ? "active" : "")" href="@Url.Action("Index", "QuestionBank", new { subject = "tiếng việt" })">📖 NH Tiếng Việt</a>
            <a class="admin-link admin-link-sub @(ViewBag.AdminNav == "questions" && ViewBag.AdminSubject as string == "tiếng anh" ? "active" : "")" href="@Url.Action("Index", "QuestionBank", new { subject = "tiếng anh" })">🌐 NH Tiếng Anh</a>
            <hr class="border-secondary-subtle my-2" />
            <a class="admin-link @(ViewBag.AdminNav == "exams" ? "active" : "")" href="@Url.Action("Index", "ExamAdmin")">Đề thi tổng hợp</a>
            <hr class="border-secondary-subtle my-3" />
            <a class="admin-link" href="@Url.Action("Index", "Learning")">Về trang học sinh</a>
            <a class="admin-link" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
        </aside>

        <div class="admin-content">
            <header class="admin-topbar">
                <h5 class="mb-0 fw-bold">@ViewBag.Title</h5>
            </header>
            <main class="admin-main">
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info">@TempData["Message"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
</body>
</html>
